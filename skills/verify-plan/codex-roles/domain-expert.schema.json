{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "summary", "domain_detected", "overlap_guard", "findings"],
  "properties": {
    "verdict": { "type": ["string", "null"], "description": "Domain-expert never issues a verdict. Always null." },
    "summary": { "type": "string", "minLength": 1 },
    "domain_detected": { "type": "string", "description": "Primary domain + 1 sentence on why this lens applies." },
    "overlap_guard": {
      "type": "array",
      "description": "Challenge IDs from other agents reviewed to avoid duplication.",
      "items": { "type": "string" }
    },
    "findings": {
      "type": "array",
      "description": "Domain-specific challenges. origin=domain-expert. item.title = challenge-topic slug source.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "origin", "claim", "concern", "failure_scenario", "alternative", "severity", "confidence", "status", "resolution", "iteration_introduced"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string", "minLength": 1 },
          "origin": { "type": "string", "enum": ["domain-expert"] },
          "claim": { "type": "string" },
          "concern": { "type": "string" },
          "failure_scenario": { "type": "string" },
          "alternative": { "type": "string" },
          "severity": { "type": "string", "enum": ["BLOCKING", "SIGNIFICANT", "MINOR"] },
          "confidence": { "type": "string", "enum": ["HIGH", "MED", "LOW"] },
          "status": { "type": "string", "enum": ["OPEN", "RESOLVED", "UNRESOLVED", "DEFERRED", "WITHDRAWN"] },
          "resolution": { "type": "string" },
          "iteration_introduced": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
