{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "description": "LITE-mode merged empirical+domain role: domain-expert + researcher (RESOLVE/SURFACE/PROBE) in one call. Verifies the plan's claims against the actual repo and domain reality; flags unsupported assertions. Never issues a verdict.",
  "required": ["verdict", "summary", "domain_detected", "unknowns_resolutions", "surfaced_contexts", "probed_risks", "findings"],
  "properties": {
    "verdict": { "type": ["string", "null"], "description": "Empirical-domain role never issues a verdict. Always null." },
    "summary": { "type": "string", "minLength": 1 },
    "domain_detected": { "type": "string", "description": "Primary domain + 1 sentence on why this lens applies." },
    "unknowns_resolutions": {
      "type": "array",
      "description": "RESOLVE: resolution of each unknown in the iteration_state manifest (empty in LITE first pass if none passed).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "type", "resolution", "finding"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "enum": ["FILE_MISSING", "API_BEHAVIOR", "PRIOR_DECISION", "STALE_KNOWLEDGE", "INTEGRATION_UNKNOWN"] },
          "resolution": { "type": "string", "enum": ["CONFIRMED", "REFUTED", "UNRESOLVABLE", "PARTIALLY_RESOLVED"] },
          "finding": { "type": "string", "description": "[VERIFIED: source | finding | impact]" }
        }
      }
    },
    "surfaced_contexts": {
      "type": "array",
      "description": "SURFACE: context from repo/memory/CLAUDE.md/git nobody connected to the plan.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "source", "location", "relevance", "impact", "generates_challenge"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "enum": ["memory", "codebase", "claude_md", "git_history"] },
          "location": { "type": "string" },
          "relevance": { "type": "string" },
          "impact": { "type": "string", "enum": ["changes_needed", "confirms_approach", "contradicts_plan"] },
          "generates_challenge": { "type": ["string", "null"] }
        }
      }
    },
    "probed_risks": {
      "type": "array",
      "description": "PROBE: blind-spot risks from divergent exploration of what is missing.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "risk", "trigger", "cascade", "probability", "severity", "generates_challenge"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string", "minLength": 1 },
          "risk": { "type": "string" },
          "trigger": { "type": "string" },
          "cascade": { "type": "string" },
          "probability": { "type": "string", "enum": ["LOW", "MED"] },
          "severity": { "type": "string", "enum": ["BLOCKING", "SIGNIFICANT", "MINOR"] },
          "generates_challenge": { "type": ["string", "null"] }
        }
      }
    },
    "findings": {
      "type": "array",
      "description": "Challenges from domain-specific flaws, contradicting surfaced contexts, and SIGNIFICANT+ probed risks (origin=empirical-domain). item.title = topic slug source.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "origin", "claim", "concern", "failure_scenario", "alternative", "severity", "confidence", "status", "resolution", "iteration_introduced"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string", "minLength": 1 },
          "origin": { "type": "string", "enum": ["empirical-domain"] },
          "claim": { "type": "string" },
          "concern": { "type": "string" },
          "failure_scenario": { "type": "string" },
          "alternative": { "type": "string" },
          "severity": { "type": "string", "enum": ["BLOCKING", "SIGNIFICANT", "MINOR"] },
          "confidence": { "type": "string", "enum": ["HIGH", "MED", "LOW"] },
          "status": { "type": "string", "enum": ["OPEN", "RESOLVED", "UNRESOLVED", "DEFERRED", "WITHDRAWN"] },
          "resolution": { "type": "string" },
          "iteration_introduced": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
